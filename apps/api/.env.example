# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3000
# The Postgres of docker-compose.dev.yml (`docker compose -f docker-compose.dev.yml up -d`).
DATABASE_URL=postgresql://birthdly:birthdly@127.0.0.1:5432/birthdly
# The web dev server; it proxies /api to this API. The OAuth client must list it as an authorized JavaScript origin.
APP_ORIGIN=http://localhost:4200
# The OAuth client in Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=<client id>
GOOGLE_CLIENT_SECRET=<client secret>
# Encrypts the sign-in cookie.
AUTH_SECRET=<openssl rand -hex 32>
# Google Calendar sync. It uses the same OAuth client, whose project must have the Google Calendar API and the People API
# enabled.
# Encrypts the saved Google refresh tokens; changing it means connecting Google Calendar again.
GOOGLE_TOKEN_ENCRYPTION_KEY=<openssl rand -hex 32>
# Ends the ids of the Google Calendar events this installation creates (up to 8 characters from 0-9 and a-v), so
# installations sharing a Google account do not remove each other's events. Every installation needs its own tag; empty
# is production's (deploy/compose.yml).
GOOGLE_CALENDAR_EVENT_TAG=dev
# Birthday push notifications: `npm run push:vapid-keys`. The public key must equal `vapidPublicKey` in
# apps/web/src/app/app.config.ts, so locally use the pair whose public key is committed there, or change it only locally.
VAPID_PUBLIC_KEY=<public key>
VAPID_PRIVATE_KEY=<private key>
VAPID_SUBJECT=mailto:<contact email>

# Optional. Set both to turn on email reminders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Comma-separated emails of the Google accounts that may open the admin pages (/admin/imports); empty means nobody.
ADMIN_EMAILS=<your email>
# People's photos: a Cloudflare R2 bucket (a separate one for development) and an API token with Object Read & Write on
# it (R2 → Manage API tokens). Leave all four unset to run without photos.
# R2_ACCOUNT_ID=<account id>
# R2_ACCESS_KEY_ID=<access key id>
# R2_SECRET_ACCESS_KEY=<secret access key>
# R2_BUCKET=birthdly-photos-dev
# false: this API does not import celebrities from Wikimedia (the import shares its rate limit with production).
# Unset means true.
# CELEBRITY_IMPORT_ENABLED=false
LOG_LEVEL=debug
